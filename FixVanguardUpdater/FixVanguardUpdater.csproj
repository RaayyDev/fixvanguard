<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>Fix Vanguard Updater</AssemblyTitle>
    <Product>Fix Vanguard Updater</Product>
    <RootNamespace>FixVanguardUpdater</RootNamespace>
    <ApplicationIcon>..\FixVanguard\VANGUARD.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(Configuration)' == 'Release'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reutilizamos la UI del loader (Theme, ConsolePanel, DarkButton, etc). -->
    <Compile Include="..\FixVanguard\Theme.cs"          Link="Shared\Theme.cs" />
    <Compile Include="..\FixVanguard\DarkButton.cs"     Link="Shared\DarkButton.cs" />
    <Compile Include="..\FixVanguard\PurpleScrollBar.cs" Link="Shared\PurpleScrollBar.cs" />
    <Compile Include="..\FixVanguard\ConsolePanel.cs"   Link="Shared\ConsolePanel.cs" />
    <Compile Include="..\FixVanguard\ActionLog.cs"      Link="Shared\ActionLog.cs" />
    <Compile Include="..\FixVanguard\Glyphs.cs"         Link="Shared\Glyphs.cs" />
    <Compile Include="..\FixVanguard\UpdateManifest.cs" Link="Shared\UpdateManifest.cs" />
  </ItemGroup>

</Project>
